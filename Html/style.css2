.container{
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: space-around;
  align-items: center;
  align-content: center;
  gap: 20px;
  height: 300px;
  background-color: lightgray;
}

.box{
  width: 100px;
  height: 100px;
  background-color: steelblue;
  color: white;
  font-size: 18px;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-grow: 1;
}